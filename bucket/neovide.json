{
    "version": "0.17.2",
    "description": "A simple GUI for Neovim",
    "homepage": "https://neovide.dev",
    "license": "MIT",
    "suggest": {
        "neovim": "neovim"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/neovide/neovide/releases/download/0.17.2/neovide-windows-x86_64.zip",
            "hash": "53fbc5bbcd41adb73badab7ae42103846a1358ef1cfa98dce8b98fae63aa4c68"
        }
    },
    "bin": "neovide.exe",
    "checkver": {
        "github": "https://github.com/neovide/neovide"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/neovide/neovide/releases/download/$version/neovide-windows-x86_64.zip"
            }
        }
    },
    "post_install": [
        "$ws = New-Object -ComObject WScript.Shell",
        "$desktop = [Environment]::GetFolderPath('Desktop')",
        "$desktopShortcut = $ws.CreateShortcut(\"$desktop\\Neovide.lnk\")",
        "$desktopShortcut.TargetPath = \"$dir\\neovide.exe\"",
        "$desktopShortcut.WorkingDirectory = \"$dir\"",
        "$desktopShortcut.IconLocation = \"$dir\\neovide.exe\"",
        "$desktopShortcut.Save()"
    ],
    "uninstaller": {
        "script": [
            "$desktop = [Environment]::GetFolderPath(\"Desktop\")",
            "Remove-Item \"$desktop\\Neovide.lnk\" -ErrorAction SilentlyContinue"
        ]
    }
}